# AI providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# PaperHub multi-source search/download
PAPERHUB_PROVIDER_NAMES=semantic_scholar,openalex,arxiv,europepmc,pmc
PAPERHUB_PROVIDER_TIMEOUT_SECONDS=15
PAPERHUB_CROSSREF_MAILTO=
PAPERHUB_OPENALEX_EMAIL=
PAPERHUB_UNPAYWALL_EMAIL=
PAPERHUB_CORE_API_KEY=
PAPERHUB_DOAJ_API_KEY=
PAPERHUB_ZENODO_ACCESS_TOKEN=

# Default model
DEFAULT_MODEL=deepseek-v4-flash
# DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Embeddings
EMBEDDING_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_EMBEDDING_DIMENSION=768

# Paper search
PAPER_SEARCH_MAX_RESULTS=100
PAPER_PDF_DIR=data/papers

# Database
DATABASE_URL=postgresql+asyncpg://litreview:litreview@localhost:5434/litreview

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ── Per-project sandbox for the AI assistant ─────────────────────────
# Modes:
#   docker  — spin up a real lumen-sandbox:latest container per project
#             (requires `docker build -t lumen-sandbox:latest sandbox_image/`)
#   stub    — run sandbox tools in a local subprocess (no Docker needed,
#             perfect for dev / tests; default if unset)
#   disabled — sandbox tools return "ENABLE_SANDBOX is off"
LUMEN_SANDBOX_MODE=stub
LUMEN_SANDBOX_IMAGE=lumen-sandbox:latest
LUMEN_SANDBOX_PORT=9090
LUMEN_SANDBOX_MEMORY=512m
LUMEN_SANDBOX_CPUS=1.0
LUMEN_SANDBOX_IDLE_TTL=1800
LUMEN_SANDBOX_SPAWN_TIMEOUT=60
LUMEN_SANDBOX_REQUEST_TIMEOUT=120
LUMEN_SANDBOX_NETWORK=bridge
LUMEN_SANDBOX_WORKSPACE_ROOT=data/sandboxes
